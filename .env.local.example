# Claude API (주장 추출 + 웹검색 기반 근거 검증) - https://console.anthropic.com
ANTHROPIC_API_KEY=
# 선택: 기본값은 claude-opus-5
CLAUDE_MODEL=

# 공공데이터포털 - 정책브리핑 정책뉴스 API (사실확인/보도자료 등 콘텐츠 유형 포함)
POLICY_NEWS_API_KEY=

# Claude 검색 실패 시 Google Search Grounding 기반 폴백
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# 로컬 Ollama (ANTHROPIC_API_KEY 없거나 Claude 검증 실패 시 폴백) - https://ollama.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
